{
  "compilerOptions": {
    "target": "ES2019", "module": "ESNext", "moduleResolution": "node", "jsx": "react-jsx",
    "strict": true, "noImplicitAny": true, "strictNullChecks": true, "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "esModuleInterop": true,
    "allowSyntheticDefaultImports": true, "skipLibCheck": true, "resolveJsonModule": true,
    "types": ["@tarojs/taro", "node"], "baseUrl": ".", "paths": { "@/*": ["src/*"] }
  },
  "include": ["src", "config", "types"], "compileOnSave": false
}
